generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Owner/public access and source-grounded writes are enforced by SQL/RPCs.
model Portfolio {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String @unique @map("user_id") @db.Uuid
  slug              String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template          String @default("studio")
  palette           String @default("chartreuse")
  colorMode         String @default("dark") @map("color_mode")
  sections          String[] @default(["about", "project", "skills"])
  revision          String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  isPublic          Boolean @default(false) @map("is_public")
  publishedSnapshot Json? @map("published_snapshot")
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  @@map("portfolios")
}

// Server-graded checks: client writes denied; grading RPC and ownership FK in SQL.
model SkillCheckAttempt {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  skill   String
  version Int
  score   Int
  passed  Boolean
  takenAt DateTime @default(now()) @map("taken_at") @db.Timestamptz(6)
  session SkillCheckSession?
  @@index([userId, takenAt(sort: Desc)], map: "skill_check_owner_time_idx")
  @@map("skill_check_attempts")
}

// Session writes, timing constraints, owner RLS and the one-active-owner partial
// unique index are enforced by the reviewed SQL migration/RPCs.
model SkillCheckSession {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  skill       String
  version     Int
  timingMode  String @map("timing_mode")
  startedAt   DateTime @map("started_at") @db.Timestamptz(6)
  deadlineAt  DateTime @map("deadline_at") @db.Timestamptz(6)
  state       String @default("active")
  resultId    String? @unique @map("result_id") @db.Uuid
  result      SkillCheckAttempt? @relation(fields: [resultId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([userId, startedAt(sort: Desc)], map: "skill_check_session_owner_time_idx")
  @@map("skill_check_sessions")
}

// Supabase-managed auth tables are intentionally not represented here.
// The auth.users FK, trigger, RLS and grants live in supabase/migrations.
model Profile {
  id                 String   @id @db.Uuid
  role               String   @default("student")
  fullName           String   @default("") @map("full_name")
  headline           String   @default("")
  location           String   @default("")
  bio                String   @default("")
  educationSummary   String   @default("") @map("education_summary")
  projectSummary     String   @default("") @map("project_summary")
  selfReportedSkills String[] @default([]) @map("self_reported_skills")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("profiles")
}

model JobPosting {
  id             String     @id
  title          String
  company        String
  initials       String
  location       String
  workMode       String     @map("work_mode")
  employmentType String     @map("employment_type")
  skills         String[]
  description    String
  color          String
  isActive       Boolean    @default(true) @map("is_active")
  isFictional    Boolean    @default(true) @map("is_fictional")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  savedJobs      SavedJob[]

  @@map("job_postings")
}

// Ownership FK to auth.users and trigger-controlled revision/timestamps live in SQL.
model SavedJob {
  userId    String     @map("user_id") @db.Uuid
  jobId     String     @map("job_id")
  status    String     @default("Saved")
  revision  String     @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  job       JobPosting @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@id([userId, jobId])
  @@index([jobId], map: "saved_jobs_job_id_idx")
  @@map("saved_jobs")
}

model EducationRecord {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  requestId String @map("request_id") @db.Uuid
  institution String
  degree String
  gpa Float?
  gpaScale Float? @map("gpa_scale")
  startDate DateTime? @map("start_date") @db.Date
  endDate DateTime? @map("end_date") @db.Date
  isCurrent Boolean @default(false) @map("is_current")
  revision String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  creationPayload Json @default("{}") @map("creation_payload")
  @@unique([userId, requestId], map: "education_records_user_id_request_id_key")
  @@map("education_records")
}

model ExperienceRecord {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  requestId String @map("request_id") @db.Uuid
  company String
  role String
  description String @default("")
  startDate DateTime? @map("start_date") @db.Date
  endDate DateTime? @map("end_date") @db.Date
  isCurrent Boolean @default(false) @map("is_current")
  revision String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  creationPayload Json @default("{}") @map("creation_payload")
  @@unique([userId, requestId], map: "experience_records_user_id_request_id_key")
  @@map("experience_records")
}

// Learning roadmap enrolment. Ownership FK to auth.users, RLS, column grants and
// trigger-controlled timestamps live in SQL (202611210001_learning_progress.sql).
model LearningEnrollment {
  userId          String             @map("user_id") @db.Uuid
  courseId        String             @map("course_id")
  goalId          String             @map("goal_id")
  experienceLevel String             @map("experience_level")
  weeklyHours     Int                @map("weekly_hours") @db.SmallInt
  resourceFormat  String             @map("resource_format")
  contentVersion  Int                @map("content_version")
  startedAt       DateTime           @default(dbgenerated("clock_timestamp()")) @map("started_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  lastActiveAt    DateTime           @default(dbgenerated("clock_timestamp()")) @map("last_active_at") @db.Timestamptz(6)
  progress        LearningProgress[]

  @@id([userId, courseId])
  @@index([userId, lastActiveAt(sort: Desc)], map: "learning_enrollments_recent")
  @@map("learning_enrollments")
}

model LearningProgress {
  userId         String             @map("user_id") @db.Uuid
  courseId       String             @map("course_id")
  itemKind       String             @map("item_kind")
  itemId         String             @map("item_id")
  state          String
  evidenceUrl    String?            @map("evidence_url")
  contentVersion Int                @map("content_version")
  updatedAt      DateTime           @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  completedAt    DateTime?          @map("completed_at") @db.Timestamptz(6)
  enrollment     LearningEnrollment @relation(fields: [userId, courseId], references: [userId, courseId], onDelete: Cascade)

  @@id([userId, courseId, itemKind, itemId])
  @@map("learning_progress")
}

// Visual builder drafts and published websites (/u/<slug>). Owner-read RLS and
// all writes via reviewed SQL functions live in 202611220001_portfolio_sites.sql.
model PortfolioSite {
  userId            String    @id @map("user_id") @db.Uuid
  draft             Json
  revision          String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String?   @unique
  published         Json?
  publishedRevision String?   @map("published_revision") @db.Uuid
  isPublic          Boolean   @default(false) @map("is_public")
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)

  @@map("portfolio_sites")
}
