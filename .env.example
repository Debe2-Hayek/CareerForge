# Public Supabase values. Safe to expose to the browser, but keep local in .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-publishable-key

# Required for production authentication: exact HTTPS origin, without a path.
# Leave unset during ordinary localhost/LAN development. Preview deployments
# need their own origin and matching Supabase callback allowlist entry.
# APP_ORIGIN=https://careerforge.example.com

# Optional local administration and development diagnostics only.
# The hosted MVP uses user sessions and Supabase RLS; it needs neither URL.
# Client generation also works without them. Keep direct credentials off Vercel.
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
