# Public Supabase values. Safe to expose to the browser, but keep local in .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-publishable-key

# Required for production authentication: exact HTTPS origin, without a path.
# Leave unset during ordinary localhost/LAN development. Preview deployments
# need their own origin and matching Supabase callback allowlist entry.
# APP_ORIGIN=https://careerforge.example.com

# Canonical public origin used by metadata, robots.txt and sitemap.xml.
# Keep this on the primary production domain even for preview deployments.
# NEXT_PUBLIC_SITE_URL=https://careerforge-phi.vercel.app

# Paste only the content value supplied by Google Search Console.
# GOOGLE_SITE_VERIFICATION=[GOOGLE_VERIFICATION_CODE]

# Optional local administration and development diagnostics only.
# The hosted MVP uses user sessions and Supabase RLS; it needs neither URL.
# Client generation also works without them. Keep direct credentials off Vercel.
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
# Safety guard for reviewed migration and database-test commands. Set this to
# the exact project ref that the two connection URLs must target.
# EXPECTED_SUPABASE_PROJECT_REF=your-project-ref

# Server-only job source key (free Himalayas API key; never NEXT_PUBLIC_).
# Used by `npm run jobs:ingest`; ingestion also works without it at lower limits.
# HIMALAYAS_API_KEY=

# Optional extra workshop feed (server-side only). See docs/WORKSHOPS.md.
# WORKSHOPS_FEED_URL=https://example.com/workshops.json
# WORKSHOPS_FEED_FORMAT=json

# Server-only AI provider (never NEXT_PUBLIC_). Powers profile autofill and the
# CV & Portfolio "Generate with AI" button. Without it both show their fallback.
# Daily limits live in supabase/migrations/202611240001_ai_runs.sql. See docs/AI.md.
# OPENROUTER_API_KEY=   (DeepSeek models via OpenRouter; preferred)
# DEEPSEEK_API_KEY=     (direct DeepSeek key; an sk-or- key here also means OpenRouter)
# AI_MODEL=             (optional override)
# Development only: AI_FAKE=1 uses a built-in test AI (no credits, labelled "test AI").
# Ignored in production and on Vercel.
# AI_FAKE=1
